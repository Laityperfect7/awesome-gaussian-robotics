{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Laityperfect7/awesome-gaussian-robotics/raw/main/schema/taxonomy.schema.json",
  "title": "Gaussian Robotics Atlas taxonomy",
  "description": "The controlled vocabulary used by every catalog resource.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categories",
    "kinds",
    "code_statuses",
    "inputs",
    "pose_requirements",
    "frameworks",
    "capabilities",
    "tags"
  ],
  "properties": {
    "categories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "kinds": {
      "$ref": "#/$defs/vocabulary"
    },
    "code_statuses": {
      "$ref": "#/$defs/vocabulary"
    },
    "inputs": {
      "$ref": "#/$defs/vocabulary"
    },
    "pose_requirements": {
      "$ref": "#/$defs/vocabulary"
    },
    "frameworks": {
      "$ref": "#/$defs/vocabulary"
    },
    "capabilities": {
      "$ref": "#/$defs/vocabulary"
    },
    "tags": {
      "$ref": "#/$defs/vocabulary"
    }
  },
  "$defs": {
    "vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9+._-]*$"
      }
    }
  }
}
